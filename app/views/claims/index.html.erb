<div class="space-y-8">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Claims Directory</h1>
      <p class="text-sm text-slate-400 mt-1">Search, filter, and inspect verified scientific consensus on trending health claims.</p>
    </div>
    <%= link_to "+ Report a Claim", new_report_path, class: "bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs transition shadow-lg shadow-emerald-500/20" %>
  </div>

  <!-- Search & Filter Bar -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-4">
    <%= form_with url: claims_path, method: :get, class: "flex flex-col md:flex-row gap-3" do |f| %>
      <div class="flex-1 relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <%= f.text_field :q, value: params[:q], placeholder: "Search claim title or summary...", class: "w-full pl-10 pr-4 py-2.5 bg-slate-950 border border-slate-700/60 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500" %>
      </div>

      <div class="w-full md:w-64">
        <%= f.select :category, options_for_select([["All Categories", ""]] + @categories.map { |c| [c, c] }, params[:category]), {}, class: "w-full py-2.5 px-3 bg-slate-950 border border-slate-700/60 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-emerald-500" %>
      </div>

      <div class="flex gap-2">
        <%= f.submit "Filter", class: "bg-slate-800 hover:bg-slate-700 text-white font-medium px-5 py-2.5 rounded-xl text-sm transition cursor-pointer" %>
        <% if params[:q].present? || params[:category].present? %>
          <%= link_to "Clear", claims_path, class: "border border-slate-700 hover:bg-slate-800 text-slate-400 hover:text-white font-medium px-4 py-2.5 rounded-xl text-sm transition flex items-center" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Results List -->
  <% if @claims.any? %>
    <div class="space-y-4">
      <% @claims.each do |claim| %>
        <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-6 hover:border-slate-700 transition space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center space-x-2">
              <span class="text-xs font-semibold text-slate-400 bg-slate-800 px-2.5 py-0.5 rounded-md">
                <%= claim.category %>
              </span>
              <span class="text-xs font-semibold uppercase tracking-wider px-2 py-0.5 rounded <%= claim.verdict == 'refuted' ? 'bg-rose-950 text-rose-300 border border-rose-800/50' : 'bg-amber-950 text-amber-300 border border-amber-800/50' %>">
                Verdict: <%= claim.verdict %>
              </span>
            </div>

            <div class="flex items-center space-x-2">
              <span class="text-xs text-slate-500">Hazard Level:</span>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold <%= claim.harm_score >= 4 ? 'bg-rose-950 text-rose-400' : 'bg-amber-950 text-amber-400' %>">
                <%= claim.harm_score %>/5
              </span>
            </div>
          </div>

          <h2 class="text-xl font-bold text-white hover:text-emerald-400 transition">
            <%= link_to claim.title, claim_path(claim) %>
          </h2>

          <p class="text-sm text-slate-400 leading-relaxed">
            <%= claim.scientific_summary %>
          </p>

          <div class="pt-2 flex items-center justify-between text-xs text-slate-500 border-t border-slate-800/50">
            <div class="flex items-center space-x-4">
              <span><%= pluralize(claim.evidence_citations.count, "Citations") %></span>
              <% if claim.regulatory_warning.present? %>
                <span class="text-rose-400 flex items-center">
                  <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  Regulatory Warning Issued
                </span>
              <% end %>
            </div>
            <%= link_to "Read Full Scientific Breakdown →", claim_path(claim), class: "text-emerald-400 hover:text-emerald-300 font-semibold" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 bg-slate-900/30 rounded-2xl border border-slate-800 space-y-4">
      <div class="text-slate-500 text-4xl">🔬</div>
      <h3 class="text-lg font-bold text-white">No claims found matching your query</h3>
      <p class="text-sm text-slate-400 max-w-md mx-auto">
        Have you encountered this claim in the wild? You can report it to our team for evidence indexing.
      </p>
      <%= link_to "Submit This Claim for Analysis", new_report_path(claim_text: params[:q]), class: "inline-block bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-5 py-2.5 rounded-xl text-sm transition" %>
    </div>
  <% end %>
</div>
