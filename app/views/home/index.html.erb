<div class="space-y-16">
  <!-- Hero Section -->
  <section class="text-center py-12 lg:py-16 max-w-4xl mx-auto space-y-8">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>Evidence-Based Counter-Pseudoscience Engine</span>
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
      Unmask health scams before they cause <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400">harm</span>.
    </h1>

    <p class="text-lg text-slate-400 max-w-2xl mx-auto">
      Search peer-reviewed consensus on viral health claims, evaluate marketing copy against FDA & FTC rules, or report deceptive products.
    </p>

    <!-- Search Box -->
    <div class="max-w-2xl mx-auto">
      <%= form_with url: claims_path, method: :get, class: "relative flex items-center shadow-2xl rounded-2xl overflow-hidden border border-slate-700/80 bg-slate-900/90 focus-within:border-emerald-500 transition" do |f| %>
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-500">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <%= f.text_field :q, placeholder: "Search any claim (e.g. Does bleach cure COVID? Does raw milk cure asthma?)...", class: "w-full pl-11 pr-32 py-4 bg-transparent text-white placeholder-slate-500 text-sm sm:text-base focus:outline-none" %>
        <div class="absolute right-2">
          <%= f.submit "Verify Claim", class: "bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-5 py-2.5 rounded-xl text-sm transition shadow-lg shadow-emerald-500/20 cursor-pointer" %>
        </div>
      <% end %>

      <!-- Sample Quick Links -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-xs text-slate-400">
        <span>Trending checks:</span>
        <%= link_to "Bleach / MMS COVID cure", claim_path("bleach-chlorine-dioxide-ingestion-cures-covid-19-autism-mms"), class: "px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 transition" %>
        <%= link_to "Raw milk asthma cure", claim_path("drinking-raw-milk-cures-lactose-intolerance-asthma"), class: "px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 transition" %>
        <%= link_to "Colloidal silver antibiotic", claim_path("colloidal-silver-as-a-natural-antibiotic-alternative"), class: "px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-slate-700 text-slate-300 transition" %>
      </div>
    </div>
  </section>

  <!-- Linter Feature Callout -->
  <section class="rounded-3xl p-8 lg:p-10 border border-slate-800 bg-gradient-to-br from-slate-900 via-slate-900/60 to-emerald-950/20 shadow-2xl relative overflow-hidden">
    <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-4">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-violet-500/10 border border-violet-500/20 text-violet-400">
          <span>B2B & Marketer Tool</span>
        </div>
        <h2 class="text-3xl font-bold text-white tracking-tight">The "Grammarly for Health Claims"</h2>
        <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
          Writing copy for supplements, functional foods, or skincare? Don't risk account bans or FTC fines. Paste your sales copy and our linter flags illegal disease claims in real-time, giving you safe, compliant rewrite alternatives.
        </p>
        <div class="pt-2 flex flex-wrap gap-4">
          <%= link_to "Open Linter Playground →", linter_path, class: "bg-gradient-to-r from-emerald-500 to-teal-400 text-slate-950 font-bold px-6 py-3 rounded-xl text-sm hover:brightness-110 transition shadow-lg shadow-emerald-500/20" %>
          <%= link_to "View Developer API", "/api/v1/claims", class: "border border-slate-700 text-slate-300 px-6 py-3 rounded-xl text-sm hover:border-slate-500 hover:text-white transition" %>
        </div>
      </div>
      <div class="lg:col-span-5 bg-slate-950/80 border border-slate-800 rounded-2xl p-5 font-mono text-xs text-slate-300 space-y-3 shadow-inner">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800 text-slate-500">
          <span>LIVE LINTER SAMPLE</span>
          <span class="text-rose-400 font-semibold">Risk: 5/5</span>
        </div>
        <p class="text-slate-400">
          "Our organic elixir <span class="bg-rose-950/80 text-rose-300 border-b-2 border-rose-500 px-1 py-0.5 rounded">cures clinical depression</span> and <span class="bg-rose-950/80 text-rose-300 border-b-2 border-rose-500 px-1 py-0.5 rounded">eliminates cancer cells</span>."
        </p>
        <div class="bg-emerald-950/60 border border-emerald-800/60 p-3 rounded-xl space-y-1">
          <span class="text-emerald-400 font-semibold text-[11px] block">✓ Compliant Alternative Suggestion:</span>
          <p class="text-emerald-200">"Supports balanced mood and cellular antioxidant defense."</p>
        </div>
      </div>
    </div>
  </section>

  <!-- High Risk Pseudoscience Directory -->
  <section class="space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-white tracking-tight">High-Hazard Health Claims</h2>
        <p class="text-sm text-slate-400">Verified debunkings backed by clinical trials and regulatory warnings.</p>
      </div>
      <%= link_to "Browse All Claims (#{Claim.count}) →", claims_path, class: "text-sm text-emerald-400 hover:text-emerald-300 font-semibold transition" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @featured_claims.each do |claim| %>
        <article class="bg-slate-900/70 border border-slate-800/80 rounded-2xl p-6 hover:border-slate-700 transition flex flex-col justify-between space-y-4 hover:shadow-xl group">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider bg-slate-800/80 px-2 py-0.5 rounded-md">
                <%= claim.category %>
              </span>
              
              <% if claim.harm_score >= 4 %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-rose-950 text-rose-400 border border-rose-800/60">
                  Hazard: <%= claim.harm_score %>/5
                </span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-950 text-amber-400 border border-amber-800/60">
                  Hazard: <%= claim.harm_score %>/5
                </span>
              <% end %>
            </div>

            <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition leading-snug">
              <%= link_to claim.title, claim_path(claim) %>
            </h3>

            <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
              <%= claim.scientific_summary %>
            </p>
          </div>

          <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-500">
            <span class="capitalize font-semibold <%= claim.verdict == 'refuted' ? 'text-rose-400' : 'text-amber-400' %>">
              Verdict: <%= claim.verdict %>
            </span>
            <span><%= claim.evidence_citations.count %> citations</span>
          </div>
        </article>
      <% end %>
    </div>
  </section>
</div>
