<div class="max-w-5xl mx-auto space-y-8">
  <div class="pb-6 border-b border-slate-800 space-y-2">
    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-violet-500/10 border border-violet-500/20 text-violet-400">
      <span>Self-Serve Pre-Publish Linter</span>
    </div>
    <h1 class="text-3xl font-extrabold text-white tracking-tight">Health Claim Compliance Linter</h1>
    <p class="text-sm text-slate-400 max-w-3xl">
      Paste your marketing copy, landing page headlines, or social ad scripts. We scan for prohibited disease claims (FDA 21 CFR 101.93) and deceptive health claims (FTC Act Section 5), then provide safe, compliant rewrite alternatives.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Input Column -->
    <div class="lg:col-span-6 space-y-4">
      <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-5 space-y-4 shadow-xl">
        <div class="flex items-center justify-between">
          <label for="linter-textarea" class="text-xs font-bold uppercase tracking-wider text-slate-400">Marketing / Product Copy</label>
          <span class="text-xs text-slate-500 font-mono">Live Check</span>
        </div>

        <%= form_with url: linter_check_path, method: :post, class: "space-y-4" do |f| %>
          <%= f.text_area :text, id: "linter-textarea", rows: 9, value: @sample_text || params[:text], placeholder: "Paste marketing copy here...", class: "w-full p-4 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-emerald-500 font-sans leading-relaxed resize-none" %>

          <div class="flex items-center justify-between">
            <div class="flex flex-wrap gap-2 text-[11px] text-slate-400">
              <span class="text-slate-500 self-center">Presets:</span>
              <button type="button" onclick="loadPreset(1)" class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition">Scam Cure</button>
              <button type="button" onclick="loadPreset(2)" class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition">Toxic Chemical</button>
              <button type="button" onclick="loadPreset(3)" class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition">Compliant Copy</button>
            </div>

            <%= f.submit "Lint Copy →", class: "bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-6 py-2.5 rounded-xl text-sm transition shadow-lg shadow-emerald-500/20 cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <!-- Compliance Guide Reference -->
      <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-900/30 text-xs text-slate-400 space-y-2">
        <span class="font-bold text-slate-300 block">The Golden Rule of Supplement Compliance:</span>
        <p>
          Under FDA DSHEA guidelines, dietary supplements may only make <strong class="text-emerald-400">structure/function claims</strong> (e.g. <em>"supports healthy immune response"</em>). They can NEVER claim to diagnose, cure, mitigate, treat, or prevent any disease (e.g. <em>"cures COVID"</em> or <em>"eliminates cancer"</em>).
        </p>
      </div>
    </div>

    <!-- Results Column -->
    <div class="lg:col-span-6 space-y-4">
      <% if @result %>
        <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-6 space-y-6 shadow-xl">
          <!-- Summary Header -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-800">
            <div class="space-y-1">
              <span class="text-xs text-slate-500 uppercase font-mono">Linter Assessment</span>
              <div>
                <% if @result.compliant? %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-950 text-emerald-400 border border-emerald-800">
                    ✓ Compliant Structure/Function Copy
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-rose-950 text-rose-400 border border-rose-800">
                    ⚠ Prohibited Claims Detected (<%= @result.flagged_segments.size %>)
                  </span>
                <% end %>
              </div>
            </div>

            <div class="text-right">
              <span class="text-xs text-slate-500 block">Hazard Score</span>
              <span class="text-2xl font-black <%= @result.risk_score >= 4 ? 'text-rose-400' : (@result.risk_score >= 2 ? 'text-amber-400' : 'text-emerald-400') %>">
                <%= @result.risk_score %> / 5
              </span>
            </div>
          </div>

          <!-- Flagged Segments Breakdown -->
          <% if @result.flagged_segments.any? %>
            <div class="space-y-4">
              <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Flagged Regulatory Infractions</h3>

              <% @result.flagged_segments.each_with_index do |flag, idx| %>
                <div class="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3">
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center space-x-2">
                      <span class="text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-rose-900/60 text-rose-300 border border-rose-700/60">
                        <%= flag[:category] %>
                      </span>
                      <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-900 text-slate-200 border border-slate-800">
                        "<%= flag[:matched_text] %>"
                      </span>
                    </div>
                    <span class="text-[11px] font-mono text-slate-500"><%= flag[:regulation] %></span>
                  </div>

                  <p class="text-xs text-slate-400 leading-relaxed">
                    <%= flag[:reason] %>
                  </p>

                  <!-- Safe Replacement Suggestion -->
                  <div class="bg-emerald-950/40 border border-emerald-800/50 p-3 rounded-lg space-y-1">
                    <div class="flex items-center justify-between text-[11px]">
                      <span class="font-bold text-emerald-400">Suggested Compliant Rewrite:</span>
                      <button type="button" onclick="navigator.clipboard.writeText('<%= j(flag[:suggested_replacement]) %>'); alert('Copied to clipboard!');" class="text-slate-400 hover:text-white underline">Copy</button>
                    </div>
                    <p class="text-xs text-emerald-200 font-medium">
                      "<%= flag[:suggested_replacement] %>"
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8 space-y-2">
              <div class="w-10 h-10 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center mx-auto text-xl font-bold">✓</div>
              <h3 class="text-sm font-bold text-white">All Clear!</h3>
              <p class="text-xs text-slate-400 max-w-sm mx-auto">
                No disease treatment, cure, or unauthorized toxic chemical claims were detected in this copy.
              </p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  function loadPreset(type) {
    const textarea = document.getElementById("linter-textarea");
    if (type === 1) {
      textarea.value = "Our organic mushroom tincture cures clinical depression and eliminates cancer cells permanently within 30 days.";
    } else if (type === 2) {
      textarea.value = "Drink 10 drops of chlorine dioxide / MMS twice daily to detoxify organs and prevent COVID infection.";
    } else if (type === 3) {
      textarea.value = "Our organic magnesium glycinate supports restful sleep, normal nerve transmission, and everyday muscle relaxation.";
    }
  }
</script>
